        }
      }
    },
    "Clicking a row opens that chat in the right Claude profile. macOS asks for this as permission to control Claude.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıra tıklayınca o sohbeti doğru Claude profilinde açar. macOS bunu \"Claude'u denetleme\" izni olarak sorar."
          }
        }
      }
    },
    "Couldn’t read the Claude Desktop folder. Full Disk Access may be needed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop klasörü okunamadı. Tam Disk Erişimi gerekebilir."
